// Alhatimi Glass and Glazing — Quotation Management System
// Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum QuotationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  passwordHash       String
  role               Role        @default(STAFF)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  preparedQuotations Quotation[] @relation("PreparedBy")
  approvedQuotations Quotation[] @relation("ApprovedBy")
  auditLogs          AuditLog[]
}

model Customer {
  id          String      @id @default(cuid())
  name        String
  companyName String?
  phone       String
  email       String?
  address     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quotations  Quotation[]

  @@index([phone])
  @@index([name])
}

model Quotation {
  id                 String          @id @default(cuid())
  quotationNumber    String          @unique
  year               Int
  sequence           Int
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id])
  projectName        String
  projectLocation    String?
  date               DateTime        @default(now())
  validUntil         DateTime?
  status             QuotationStatus @default(DRAFT)
  items              QuotationItem[]

  subTotal           Decimal         @db.Decimal(12, 2)
  discountType       DiscountType    @default(PERCENT)
  discountValue      Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(12, 2)
  vatPercent         Decimal         @default(0) @db.Decimal(5, 2)
  vatAmount          Decimal         @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal         @db.Decimal(12, 2)
  finalTotal         Decimal         @db.Decimal(12, 2)

  preparedById       String
  preparedBy         User            @relation("PreparedBy", fields: [preparedById], references: [id])
  approvedById       String?
  approvedBy         User?           @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?

  notes              String?
  termsAndConditions String?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([year, sequence])
  @@index([status])
  @@index([customerId])
  @@index([date])
}

model QuotationItem {
  id            String       @id @default(cuid())
  quotationId   String
  quotation     Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position      Int
  description   String
  category      String?
  width         Decimal      @db.Decimal(10, 3)
  height        Decimal      @db.Decimal(10, 3)
  quantity      Decimal      @default(1) @db.Decimal(10, 2)
  area          Decimal      @db.Decimal(12, 4)
  unitPrice     Decimal      @db.Decimal(12, 2)
  discountType  DiscountType @default(PERCENT)
  discountValue Decimal      @default(0) @db.Decimal(12, 2)
  amount        Decimal      @db.Decimal(12, 2)

  @@index([quotationId])
  @@index([description])
}

model CompanySettings {
  id                     String   @id @default("singleton")
  companyName            String   @default("Alhatimi Glass and Glazing")
  logoUrl                String?
  address                String?
  phone                  String?
  email                  String?
  website                String?
  currency               String   @default("USD")
  defaultTaxPercent      Decimal  @default(0) @db.Decimal(5, 2)
  defaultDiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  footerText             String   @default("Thank you for choosing Alhatimi Glass and Glazing.")
  termsAndConditions     String?
  updatedAt              DateTime @updatedAt
}

model QuotationCounter {
  year         Int @id
  lastSequence Int @default(0)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
